# Copy to .env.local for local development; production values go to Vercel
# Project Settings > Environment Variables. Never commit real secrets.

# Base URL used for canonical URLs, OG images, and absolute links.
# Local dev runs behind https://krutan.localhost (see allowedDevOrigins in
# next.config.ts); production is https://krutan.site
NEXT_PUBLIC_APP_URL=http://krutan.localhost

# Public API for the GitHub contributions heatmap on the home page.
NEXT_PUBLIC_GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de/v4

# shadcn-style component registry alias served from this site.
NEXT_PUBLIC_REGISTRY_NAMESPACE=@krutan
NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=http://krutan.localhost/r/{name}.json

# OpenPanel analytics (https://openpanel.dev). Empty disables all tracking.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Buy-me-a-coffee receiver. The UPI ID alone enables the direct
# upi://pay intent flow; the YouPI PG fields upgrade the button to the
# verified checkout (self-hosted gateway, https://github.com/youpi-pg/YouPI-PG).
NEXT_PUBLIC_COFFEE_PAYEE_NAME=Krutan Lakeshri
NEXT_PUBLIC_COFFEE_UPI_ID=
NEXT_PUBLIC_YOUPI_GATEWAY_URL=
NEXT_PUBLIC_YOUPI_MERCHANT_KEY=

# Server-side secrets for the /api/youpi-webhook receiver.
# YOUPI_WEBHOOK_SECRET: the webhook signing secret from the YouPI merchant admin.
# YOUPI_DISCORD_WEBHOOK_URL (optional): post each coffee payment to Discord.
YOUPI_WEBHOOK_SECRET=
YOUPI_DISCORD_WEBHOOK_URL=

# Discord webhook for the docs feedback widget. Empty logs feedback in dev.
DISCORD_FEEDBACK_WEBHOOK_URL=

# DMCA protection badge target, used by the footer protection icon.
NEXT_PUBLIC_DMCA_URL=
